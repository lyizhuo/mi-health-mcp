# Required: Fernet key used to encrypt the Xiaomi passToken at rest.
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MI_HEALTH_MASTER_KEY=

# Admin login (generate hash: mi-health admin hash-password)
MI_HEALTH_ADMIN_PASSWORD_HASH=
# Random secret for signed session cookies (required in production)
MI_HEALTH_SESSION_SECRET=
# Set to 1 when served over HTTPS (cookie Secure flag)
MI_HEALTH_HTTPS_ONLY=1

# Xiaomi region: cn, ru, de, i2, sg, us
MI_HEALTH_REGION=cn

# MCP DNS-rebinding allowlist. Set the public reverse-proxy host.
MI_HEALTH_ALLOWED_HOSTS=health.example.com,127.0.0.1,127.0.0.1:*

# Sync cadence / retention (defaults shown)
MI_HEALTH_SYNC_HIGH_INTERVAL=1800
MI_HEALTH_SYNC_OTHER_INTERVAL=43200
MI_HEALTH_BACKFILL_DAYS=90
MI_HEALTH_RAW_RETENTION_DAYS=180
